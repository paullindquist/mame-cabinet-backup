# Push the cabinet's config backup to GitHub using a dedicated deploy key
# rather than an account-wide key, so this box can only ever touch the one
# repo that key is attached to.
#
# IdentitiesOnly stops ssh from offering any other key it happens to find,
# which is what makes the scoping actually hold.
Host github.com
    HostName github.com
    User git
    IdentityFile /home/paul/.ssh/id_cabinet_deploy
    IdentitiesOnly yes
    # The nightly push runs from cron with no terminal, so never prompt --
    # github.com's host key is already pinned in known_hosts.
    BatchMode yes
    StrictHostKeyChecking yes
